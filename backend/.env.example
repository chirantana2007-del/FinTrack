# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=4000
NODE_ENV=development

# CORS — the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fintrack

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
