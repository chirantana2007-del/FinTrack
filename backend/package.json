{
  "name": "fintrack-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FinTrack backend API (Express + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "bench:indexes": "node scripts/index-benchmark.js",
    "db:backup": "node scripts/db-backup.js",
    "drill:backup": "node scripts/backup-drill.js",
    "verify:dashboard": "node scripts/verify-dashboard.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/integration/"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.10.2",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
